/* The environment that integrates GTK and Qt applications into the desktop.
 *
 * The session does not export it. The programs that start applications
 * (Workspace, and Terminal for its shells) add it to the environment of a
 * native program and leave it out for a program of another operating system,
 * such as a Linux program on a BSD, which cannot load these native libraries.
 *
 * Each group applies when its Requires path exists (the components are
 * optional). Each value is added in front of the variable's colon-separated
 * list unless the list already has it.
 */
(
  /* GTK 2/3/4 and Qt 5/6 applications show their menus in Menu
     (gershwin-components Menu/ToolkitModules). gad only starts the menu
     module and leaves the theme to the next name of the list. */
  {
    Requires = "/System/Library/Libraries/appmenu-do";
    Environment = {
      GTK_PATH = "/System/Library/Libraries/appmenu-do";
      GTK_MODULES = "gtk-appmenu-do";
      QT_PLUGIN_PATH = "/System/Library/Libraries/appmenu-do";
      QT_QPA_PLATFORMTHEME = "gad";
      GIO_EXTRA_MODULES = "/System/Library/Libraries/appmenu-do/gio/modules";
    };
  },
  /* GTK 3 windows with a header bar get the window manager's title bar
     instead of a second one drawn by the application (gershwin-components
     GtkNoCSD). */
  {
    Requires = "/System/Library/Libraries/libgershwin-gtk-nocsd.so";
    Environment = {
      LD_PRELOAD = "/System/Library/Libraries/libgershwin-gtk-nocsd.so";
    };
  }
)
